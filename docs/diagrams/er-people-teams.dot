graph Chen {
graph [rankdir=LR, overlap=false, splines=true, nodesep=0.3, ranksep=1.1, bgcolor="white", pad=0.35, label="DraftBoard — People & Teams\nUnderlined oval: key | double oval: multivalued | dashed oval: derived\n1 / n / m at entity ends; double line: total participation", labelloc=t, fontsize=20];
node [fontname="Helvetica", fontsize=12, shape=box];
edge [fontname="Helvetica", fontsize=13, dir=none, labeldistance=1.7];
person [label="PERSON", penwidth=1.5];
person_person_id [shape=ellipse, label=<<U>person_id</U>>];
person -- person_person_id [weight=2];
person_f_name [shape=ellipse, label=<f_name>];
person -- person_f_name [weight=2];
person_l_name [shape=ellipse, label=<l_name>];
person -- person_l_name [weight=2];
person_dob [shape=ellipse, label=<dob>];
person -- person_dob [weight=2];
person_email [shape=ellipse, label=<email>];
person -- person_email [weight=2];
person_password_hash [shape=ellipse, label=<password_hash>];
person -- person_password_hash [weight=2];
person_role [shape=ellipse, label=<role>];
person -- person_role [weight=2];
person_phone [shape=ellipse, peripheries=2, label="phone_number"];
person -- person_phone;
address [shape=ellipse];
person -- address;
address_street [shape=ellipse,label="street"];
address -- address_street;
address_city [shape=ellipse,label="city"];
address -- address_city;
address_state [shape=ellipse,label="state"];
address -- address_state;
address_zip [shape=ellipse,label="zip"];
address -- address_zip;
scout [label="SCOUT", penwidth=1.5];
scout_experience [shape=ellipse, label=<experience>];
scout -- scout_experience [weight=2];
analyst [label="ANALYST", penwidth=1.5];
analyst_specialization [shape=ellipse, label=<specialization>];
analyst -- analyst_specialization [weight=2];
team_manager [label="TEAM MANAGER", penwidth=1.5];
admin [label="ADMIN", penwidth=1.5];
team [label="TEAM", penwidth=1.5];
team_team_id [shape=ellipse, label=<<U>team_id</U>>];
team -- team_team_id [weight=2];
team_external_id [shape=ellipse, label=<external_id>];
team -- team_external_id [weight=2];
team_team_name [shape=ellipse, label=<team_name>];
team -- team_team_name [weight=2];
team_city [shape=ellipse, label=<city>];
team -- team_city [weight=2];
team_need [label="TEAM NEED", penwidth=1.5];
team_need_need_id [shape=ellipse, label=<<U>need_id</U>>];
team_need -- team_need_need_id [weight=2];
team_need_position [shape=ellipse, label=<position>];
team_need -- team_need_position [weight=2];
team_need_priority [shape=ellipse, label=<priority>];
team_need -- team_need_priority [weight=2];
team_need_description [shape=ellipse, label=<description>];
team_need -- team_need_description [weight=2];
team_need_is_filled [shape=ellipse, label=<is_filled>];
team_need -- team_need_is_filled [weight=2];
roster [label="ROSTER", penwidth=1.5];
roster_roster_id [shape=ellipse, label=<<U>roster_id</U>>];
roster -- roster_roster_id [weight=2];
roster_season [shape=ellipse, label=<season>];
roster -- roster_season [weight=2];
roster_is_historical [shape=ellipse, label=<is_historical>];
roster -- roster_is_historical [weight=2];
player [label="PLAYER", penwidth=1.5];
player_player_id [shape=ellipse, label=<<U>player_id</U>>];
player -- player_player_id [weight=2];
player_external_id [shape=ellipse, label=<external_id>];
player -- player_external_id [weight=2];
player_f_name [shape=ellipse, label=<f_name>];
player -- player_f_name [weight=2];
player_l_name [shape=ellipse, label=<l_name>];
player -- player_l_name [weight=2];
player_dob [shape=ellipse, label=<dob>];
player -- player_dob [weight=2];
player_height_cm [shape=ellipse, label=<height_cm>];
player -- player_height_cm [weight=2];
player_weight_kg [shape=ellipse, label=<weight_kg>];
player -- player_weight_kg [weight=2];
player_position [shape=ellipse, label=<position>];
player -- player_position [weight=2];
player_secondary_position [shape=ellipse, label=<secondary_position>];
player -- player_secondary_position [weight=2];
player_position_group [shape=ellipse, label=<position_group>];
player -- player_position_group [weight=2];
audit_log [label="AUDIT LOG", penwidth=1.5];
audit_log_audit_id [shape=ellipse, label=<<U>audit_id</U>>];
audit_log -- audit_log_audit_id [weight=2];
audit_log_table_name [shape=ellipse, label=<table_name>];
audit_log -- audit_log_table_name [weight=2];
audit_log_action [shape=ellipse, label=<action>];
audit_log -- audit_log_action [weight=2];
audit_log_record_key [shape=ellipse, label=<record_key>];
audit_log -- audit_log_record_key [weight=2];
audit_log_old_data [shape=ellipse, label=<old_data>];
audit_log -- audit_log_old_data [weight=2];
audit_log_new_data [shape=ellipse, label=<new_data>];
audit_log -- audit_log_new_data [weight=2];
audit_log_changed_at [shape=ellipse, label=<changed_at>];
audit_log -- audit_log_changed_at [weight=2];
r0 [shape=diamond,label="manages",height=0.65];
team_manager -- r0 [taillabel="n",color="black:black", labeldistance=2.3, labelangle=35];
r0 -- team [headlabel="1",color="black"];
r1 [shape=diamond,label="requires",height=0.65];
team -- r1 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r1 -- team_need [headlabel="n",color="black:black"];
r2 [shape=diamond,label="owns",height=0.65];
team -- r2 [taillabel="1",color="black", labeldistance=4.3, labelangle=35];
r2 -- roster [headlabel="n",color="black:black"];
r3 [shape=diamond,label="includes",height=0.65];
roster -- r3 [taillabel="m",color="black", labeldistance=2.3, labelangle=35];
r3 -- player [headlabel="n",color="black"];
includes_season [shape=ellipse,label="season"];
r3 -- includes_season;
r14 [shape=diamond,label="attributed to",height=0.65];
person -- r14 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r14 -- audit_log [headlabel="n",color="black"];
person_isa [shape=triangle,label="ISA\nd, total",fontsize=10];
person -- person_isa [color="black:black"];
person_isa -- scout;
person_isa -- analyst;
person_isa -- team_manager;
person_isa -- admin;
}
