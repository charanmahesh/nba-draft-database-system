graph Chen {
graph [rankdir=LR, overlap=false, splines=true, nodesep=0.3, ranksep=1.1, bgcolor="white", pad=0.35, label="DraftBoard — Players & Games\nUnderlined oval: key | double oval: multivalued | dashed oval: derived\n1 / n / m at entity ends; double line: total participation", labelloc=t, fontsize=20];
node [fontname="Helvetica", fontsize=12, shape=box];
edge [fontname="Helvetica", fontsize=13, dir=none, labeldistance=1.7];
player [label="PLAYER", penwidth=1.5];
player_player_id [shape=ellipse, label=<<U>player_id</U>>];
player -- player_player_id [weight=2];
player_external_id [shape=ellipse, label=<external_id>];
player -- player_external_id [weight=2];
player_f_name [shape=ellipse, label=<f_name>];
player -- player_f_name [weight=2];
player_l_name [shape=ellipse, label=<l_name>];
player -- player_l_name [weight=2];
player_dob [shape=ellipse, label=<dob>];
player -- player_dob [weight=2];
player_height_cm [shape=ellipse, label=<height_cm>];
player -- player_height_cm [weight=2];
player_weight_kg [shape=ellipse, label=<weight_kg>];
player -- player_weight_kg [weight=2];
player_position [shape=ellipse, label=<position>];
player -- player_position [weight=2];
player_secondary_position [shape=ellipse, label=<secondary_position>];
player -- player_secondary_position [weight=2];
player_position_group [shape=ellipse, label=<position_group>];
player -- player_position_group [weight=2];
draft_prospect [label="DRAFT PROSPECT\n(future extension)", penwidth=1.5];
draft_prospect_prospect_id [shape=ellipse, label=<<U>prospect_id</U>>];
draft_prospect -- draft_prospect_prospect_id [weight=2];
draft_prospect_college [shape=ellipse, label=<college>];
draft_prospect -- draft_prospect_college [weight=2];
draft_prospect_class_year [shape=ellipse, label=<class_year>];
draft_prospect -- draft_prospect_class_year [weight=2];
combined_measurement [label="COMBINED MEASUREMENT", penwidth=1.5];
combined_measurement_measurement_id [shape=ellipse, label=<<U>measurement_id</U>>];
combined_measurement -- combined_measurement_measurement_id [weight=2];
combined_measurement_measurement_type [shape=ellipse, label=<measurement_type>];
combined_measurement -- combined_measurement_measurement_type [weight=2];
combined_measurement_combine_year [shape=ellipse, label=<combine_year>];
combined_measurement -- combined_measurement_combine_year [weight=2];
combined_measurement_measured_on [shape=ellipse, label=<measured_on>];
combined_measurement -- combined_measurement_measured_on [weight=2];
combined_measurement_value [shape=ellipse, label=<value>];
combined_measurement -- combined_measurement_value [weight=2];
combined_measurement_unit [shape=ellipse, label=<unit>];
combined_measurement -- combined_measurement_unit [weight=2];
injury_history [label="INJURY HISTORY", penwidth=1.5];
injury_history_injury_id [shape=ellipse, label=<<U>injury_id</U>>];
injury_history -- injury_history_injury_id [weight=2];
injury_history_injury_date [shape=ellipse, label=<injury_date>];
injury_history -- injury_history_injury_date [weight=2];
injury_history_description [shape=ellipse, label=<description>];
injury_history -- injury_history_description [weight=2];
injury_history_severity [shape=ellipse, label=<severity>];
injury_history -- injury_history_severity [weight=2];
team [label="TEAM", penwidth=1.5];
team_team_id [shape=ellipse, label=<<U>team_id</U>>];
team -- team_team_id [weight=2];
team_external_id [shape=ellipse, label=<external_id>];
team -- team_external_id [weight=2];
team_team_name [shape=ellipse, label=<team_name>];
team -- team_team_name [weight=2];
team_city [shape=ellipse, label=<city>];
team -- team_city [weight=2];
game [label="GAME", penwidth=1.5];
game_game_id [shape=ellipse, label=<<U>game_id</U>>];
game -- game_game_id [weight=2];
game_external_id [shape=ellipse, label=<external_id>];
game -- game_external_id [weight=2];
game_game_date [shape=ellipse, label=<game_date>];
game -- game_game_date [weight=2];
game_season [shape=ellipse, label=<season>];
game -- game_season [weight=2];
game_performance [label="GAME PERFORMANCE", penwidth=1.5];
game_performance_performance_id [shape=ellipse, label=<<U>performance_id</U>>];
game_performance -- game_performance_performance_id [weight=2];
game_performance_minutes [shape=ellipse, label=<minutes>];
game_performance -- game_performance_minutes [weight=2];
game_performance_points [shape=ellipse, label=<points>];
game_performance -- game_performance_points [weight=2];
game_performance_rebounds [shape=ellipse, label=<rebounds>];
game_performance -- game_performance_rebounds [weight=2];
game_performance_assists [shape=ellipse, label=<assists>];
game_performance -- game_performance_assists [weight=2];
game_performance_blocks [shape=ellipse, label=<blocks>];
game_performance -- game_performance_blocks [weight=2];
game_performance_steals [shape=ellipse, label=<steals>];
game_performance -- game_performance_steals [weight=2];
r4 [shape=diamond,label="measured by",height=0.65];
player -- r4 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r4 -- combined_measurement [headlabel="n",color="black:black"];
r7 [shape=diamond,label="sustains",height=0.65];
player -- r7 [taillabel="1",color="black", labeldistance=4.3, labelangle=35];
r7 -- injury_history [headlabel="n",color="black:black"];
r8 [shape=diamond,label="home",height=0.65];
team -- r8 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r8 -- game [headlabel="n",color="black:black"];
r9 [shape=diamond,label="away",height=0.65];
team -- r9 [taillabel="1",color="black", labeldistance=4.3, labelangle=35];
r9 -- game [headlabel="n",color="black:black"];
r10 [shape=diamond,label="records",height=0.65];
game -- r10 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r10 -- game_performance [headlabel="n",color="black:black"];
r11 [shape=diamond,label="produces",height=0.65];
player -- r11 [taillabel="1",color="black", labeldistance=6.3, labelangle=35];
r11 -- game_performance [headlabel="n",color="black:black"];
r12 [shape=diamond,label="represented by",height=0.65];
team -- r12 [taillabel="1",color="black", labeldistance=6.3, labelangle=35];
r12 -- game_performance [headlabel="n",color="black:black"];
player_isa [shape=triangle,label="ISA\npartial",fontsize=10];
player -- player_isa;
player_isa -- draft_prospect [color="black:black"];
}
