graph Chen {
graph [rankdir=LR, overlap=false, splines=true, nodesep=0.3, ranksep=1.1, bgcolor="white", pad=0.35, label="DraftBoard — Reports & News\nUnderlined oval: key | double oval: multivalued | dashed oval: derived\n1 / n / m at entity ends; double line: total participation", labelloc=t, fontsize=20];
node [fontname="Helvetica", fontsize=12, shape=box];
edge [fontname="Helvetica", fontsize=13, dir=none, labeldistance=1.7];
player [label="PLAYER", penwidth=1.5];
player_player_id [shape=ellipse, label=<<U>player_id</U>>];
player -- player_player_id [weight=2];
player_external_id [shape=ellipse, label=<external_id>];
player -- player_external_id [weight=2];
player_f_name [shape=ellipse, label=<f_name>];
player -- player_f_name [weight=2];
player_l_name [shape=ellipse, label=<l_name>];
player -- player_l_name [weight=2];
player_dob [shape=ellipse, label=<dob>];
player -- player_dob [weight=2];
player_height_cm [shape=ellipse, label=<height_cm>];
player -- player_height_cm [weight=2];
player_weight_kg [shape=ellipse, label=<weight_kg>];
player -- player_weight_kg [weight=2];
player_position [shape=ellipse, label=<position>];
player -- player_position [weight=2];
player_secondary_position [shape=ellipse, label=<secondary_position>];
player -- player_secondary_position [weight=2];
player_position_group [shape=ellipse, label=<position_group>];
player -- player_position_group [weight=2];
scout [label="SCOUT", penwidth=1.5];
scout_experience [shape=ellipse, label=<experience>];
scout -- scout_experience [weight=2];
scouting_report [label="SCOUTING REPORT", penwidth=1.5];
scouting_report_report_id [shape=ellipse, label=<<U>report_id</U>>];
scouting_report -- scouting_report_report_id [weight=2];
scouting_report_report_date [shape=ellipse, label=<report_date>];
scouting_report -- scouting_report_report_date [weight=2];
scouting_report_summary [shape=ellipse, label=<summary>];
scouting_report -- scouting_report_summary [weight=2];
scouting_report_embedding [shape=ellipse, label=<embedding>];
scouting_report -- scouting_report_embedding [weight=2];
scouting_report_embedding_model [shape=ellipse, label=<embedding_model>];
scouting_report -- scouting_report_embedding_model [weight=2];
scouting_report_embedded_at [shape=ellipse, label=<embedded_at>];
scouting_report -- scouting_report_embedded_at [weight=2];
scouting_report_search_vector [shape=ellipse, label=<search_vector>, style=dashed];
scouting_report -- scouting_report_search_vector [weight=2];
news_article [label="NEWS ARTICLE", penwidth=1.5];
news_article_article_id [shape=ellipse, label=<<U>article_id</U>>];
news_article -- news_article_article_id [weight=2];
news_article_title [shape=ellipse, label=<title>];
news_article -- news_article_title [weight=2];
news_article_publish_date [shape=ellipse, label=<publish_date>];
news_article -- news_article_publish_date [weight=2];
news_article_summary [shape=ellipse, label=<summary>];
news_article -- news_article_summary [weight=2];
news_article_url [shape=ellipse, label=<url>];
news_article -- news_article_url [weight=2];
news_article_embedding [shape=ellipse, label=<embedding>];
news_article -- news_article_embedding [weight=2];
news_article_embedding_model [shape=ellipse, label=<embedding_model>];
news_article -- news_article_embedding_model [weight=2];
news_article_embedded_at [shape=ellipse, label=<embedded_at>];
news_article -- news_article_embedded_at [weight=2];
news_article_search_vector [shape=ellipse, label=<search_vector>, style=dashed];
news_article -- news_article_search_vector [weight=2];
r5 [shape=diamond,label="assessed in",height=0.65];
player -- r5 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r5 -- scouting_report [headlabel="n",color="black:black"];
r6 [shape=diamond,label="writes",height=0.65];
scout -- r6 [taillabel="1",color="black", labeldistance=2.3, labelangle=35];
r6 -- scouting_report [headlabel="n",color="black:black"];
r13 [shape=diamond,label="mentions",height=0.65];
news_article -- r13 [taillabel="m",color="black", labeldistance=2.3, labelangle=35];
r13 -- player [headlabel="n",color="black"];
}
